# ============================================================
#  電子お薬手帳 Webアプリ - 環境変数サンプル
#  このファイルを .env にコピーして値を設定してください
# ============================================================

# サーバー設定
PORT=3000
NODE_ENV=development

# フロントエンドのオリジン（CORS許可用）
FRONTEND_ORIGIN=http://localhost:5173

# ----------------------------------------------------------
# Supabase設定
# Supabaseダッシュボード > Project Settings > API から取得
# ----------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# service_role キーはバックエンドのみで使用すること（絶対にフロントへ渡さない）
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ----------------------------------------------------------
# Web Push設定 (VAPID鍵)
# `npx web-push generate-vapid-keys` で生成
# ----------------------------------------------------------
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@example.com

# ----------------------------------------------------------
# ネイティブ版（Android アプリ）へのプッシュ通知（Firebase Cloud Messaging）
# Firebase コンソール > プロジェクトの設定 > サービス アカウント >「新しい秘密鍵を生成」で
# ダウンロードした JSON の中身を、そのまま1つの値として設定する（Base64 にした値でもよい）。
# 秘密の鍵なので、リポジトリには入れないこと。未設定ならアプリへの通知だけが送られない。
# ----------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT=
